# Copy only the required settings into the root .env. Defaults capture mail locally.
REPORT_MAIL_OUTBOUND_ENABLED=false
REPORT_MAIL_FROM=reports@localhost.invalid
REPORT_MAIL_SPOOL_PATH=uploads/report-mail
REPORT_MAIL_WORKERS=1
REPORT_MAIL_QUEUE_CAPACITY=4
REPORT_MAIL_TIMEOUT_MILLIS=10000
REPORT_MAIL_MAX_MESSAGE_BYTES=20000000
REPORT_MAIL_MAX_ATTEMPTS=5

# Configure a real sender/provider only when outbound delivery is explicitly activated.
REPORT_MAIL_SMTP_HOST=
REPORT_MAIL_SMTP_PORT=587
REPORT_MAIL_SMTP_USERNAME=
REPORT_MAIL_SMTP_PASSWORD=
REPORT_MAIL_STARTTLS=true
REPORT_MAIL_SSL=false
