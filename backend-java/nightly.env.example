# Scheduling stays disabled until a dataset source/profile has been configured and verified.
NIGHTLY_ENABLED=false
NIGHTLY_TICK_MILLIS=30000
NIGHTLY_STABLE_SECONDS=60
NIGHTLY_MAX_SOURCE_BYTES=200000000
NIGHTLY_MAX_ACTIVE_RUNS=20
NIGHTLY_MAX_ATTEMPTS=3
# Schedule: 01:00 Asia/Kolkata. Default input cutoff 01:30, target 02:00.
# Configure each dataset folder, filename pattern, identity, mappings and delivery goal via /api/v1/nightly/profile.
# REPORT_ONLY and CAPTURE do not send email. SMTP additionally requires an enabled report mail profile and provider.
